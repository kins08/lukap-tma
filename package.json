{
  "name": "lukap-tma",
  "version": "24.0.0",
  "private": true,
  "description": "LUKAP — Telegram Mini App fashion-gacha prototype",
  "scripts": {
    "prestart": "npm run build",
    "start": "node server.js",
    "check": "node scripts/check-static.js && node scripts/check-catalog.js",
    "prebuild": "npm test",
    "build": "npm run check && node scripts/build-static.js",
    "test": "node --test tests/*.test.js",
    "simulate": "node scripts/simulate-economy.js",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist --project-name lukap-tma",
    "e2e": "node scripts/e2e-smoke.js",
    "simulate:cohort": "node scripts/economy-sim.js"
  },
  "engines": {
    "node": ">=20"
  }
}
